# Runtime state — these are written to ~/.claude/, not the repo, but
# guard against accidental copies landing here during local edits.
.statusline-cols*
.statusline-width-debug.log
*.log
# Usage dashboard build output (it inlines every reading) and dependencies
usage/node_modules/
usage/dist/
# Usage readings live in each Claude Code profile folder, never here
*.db
*.db-shm
*.db-wal
